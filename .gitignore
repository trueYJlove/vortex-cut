node_modules/
apps/desktop/node_modules/
apps/desktop/out/
apps/desktop/dist/
apps/desktop/release/
packages/*/dist/
.venv/
.eggs/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
**/__pycache__/
.aivideo-integration/
.aivideo/
test-assets/generated/
dist/

# 临时产物（截图、探针输出、vitest --outputFile 等）。
# 我两次把 apps/.tmp/vitest.json 误提交进仓，根因是这里没有规则、只能靠记得。
# 记性靠不住，就写进规则。
.tmp/
apps/.tmp/

# Local build, packaging and dependency staging outputs
.deps-download/
build/
# apps/desktop/build/icon.ico 是品牌图标源资产（exe/安装包/快捷方式图标），必须入库；
# 该目录下的其余本地产物（如 aivs-core 暂存）保持忽略。
!apps/desktop/build/
apps/desktop/build/*
!apps/desktop/build/icon.ico
package/
resources/core/
resources/ffmpeg/win-x64/
services/core/build/
*.tgz

# Local desktop and integration test state
test-results/
apps/desktop/test-results/

# Local dependency, coverage and verification helper outputs
/.pnpm-store/
/apps/desktop/coverage/
/aivs-core.spec
/%AIVS_VERIFY_REAL_STDOUT%
/%AIVS_VERIFY_REAL_STDERR%

# Local runtime scratch and desktop build caches
/.tmp/
/apps/desktop/.cache/
/test-tmp/

# Local secrets
.env

# M3-0 探针证据（批量二进制不入库；清单与结果 JSON 入库）
evidence/m3_0/**/*.mkv
evidence/m3_0/**/*.mp4
evidence/m3_0/**/*.png
evidence/m3_0/**/frames/
evidence/m3_0/**/fonts/
evidence/m3_0/**/gl/
evidence/m3_0/**/gl_nocap/
evidence/m3_0/**/step0/
evidence/m3_0/**/assets.manifest*.json

# Performance evidence: keep compact manifests/configs and human-readable summaries (< 200 KB);
# generated media, raw logs, per-frame/run traces, and heavy outputs stay local.
evidence/performance/**/*.mp4
evidence/performance/**/*.png
evidence/performance/**/*.log
evidence/performance/**/*.jsonl
evidence/performance/**/user-data/
evidence/performance/**/results-*.json
evidence/performance/**/results.json
evidence/performance/**/run-*/result.json
evidence/performance/**/app-drop-*.json
evidence/performance/**/app-multiclip-*.json
evidence/performance/**/ir_*.json

# Visual acceptance captures & debug dumps; conclusions and measurements live in Markdown summaries.
evidence/**/*.png
evidence/**/*.mp4
evidence/**/*.mkv
/evidence/2026-11-11-light-theme/
/evidence/2026-11-11-timeline-parity/
/evidence/2026-11-18-p231-preview-canvas/
/evidence/2026-10-08-transcript-ui/
/evidence/m3_2/
/evidence/p235-openfilm-timeline-parity-*/

# Test-time model download cache (sha256-verified per test fixture)
resources/.test-model-cache/
.validation/

# Windows 文件权限诊断/修复工具的输出（含 ACL 备份与回滚脚本），非项目产物
/.acl-recovery/

# Agent / Codex 临时工具目录（匹配根级与子包下的 .codex-tmp/）
.codex-tmp/

# uv 本地缓存
.uv-cache/

# 脚本可确定性再生的本地对比媒体夹具
tools/openfilm-timeline-parity/media/

# 证据目录下的音频波形等大型媒体文件（保留轻量 <200KB JSON 摘要）
evidence/**/*.wav
