{
  "name": "@aivideo/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Vortex Cut 桌面端：本地优先、AI 驱动的视频剪辑与多平台创作工具",
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "build:e2e": "node scripts/build-e2e.mjs",
    "test:e2e": "pnpm build:e2e && playwright test --config=tests/playwright.config.ts",
    "package:win": "node scripts/package-win.mjs",
    "package:verify": "node scripts/verify-probe-isolation.mjs && powershell -NoProfile -ExecutionPolicy Bypass -File ../../tools/packaging/verify-windows.ps1",
    "verify:probe-isolation": "node scripts/verify-probe-isolation.mjs",
    "package:verify:real": "node scripts/verify-package-real.mjs"
  },
  "dependencies": {
    "@aivideo/contracts": "workspace:*",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electron/get": "3.1.0",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "3.2.7",
    "electron": "^36.2.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
