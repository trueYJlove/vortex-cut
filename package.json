{
  "name": "aivideo-studio",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @aivideo/desktop dev",
    "build": "pnpm --filter @aivideo/desktop build",
    "lint": "pnpm --filter @aivideo/desktop lint",
    "typecheck": "pnpm --filter @aivideo/contracts build && pnpm --filter @aivideo/desktop typecheck",
    "test": "pnpm --filter @aivideo/contracts build && pnpm --filter @aivideo/desktop test",
    "test:e2e": "pnpm --filter @aivideo/desktop test:e2e",
    "verify:stage0:real": "python tools/verify_stage0_real.py",
    "verify:desktop:real": "pnpm --filter @aivideo/desktop build && node tools/verify_desktop_real.mjs",
    "contracts:generate": "pnpm --filter @aivideo/contracts build",
    "sidecar:build": "uv run pyinstaller --noconfirm --clean --onedir --name aivs-core services/core/src/aivs_core/bootstrap.py",
    "package:win": "pnpm --filter @aivideo/desktop package:win",
    "package:verify": "pnpm --filter @aivideo/desktop package:verify",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
